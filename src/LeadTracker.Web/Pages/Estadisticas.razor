@page "/estadisticas"
@inject MockDataService DataService

<PageTitle>Flujo.ai — Estadísticas</PageTitle>

<header class="topbar">
    <div>
        <h1>Estadísticas</h1>
        <p class="subtitle">Resumen de captación de leads</p>
    </div>
    <div class="date-chip">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Hoy, @DateTime.Now.ToString("d 'de' MMMM", new System.Globalization.CultureInfo("es-UY"))
    </div>
</header>

<div class="stats-view">
    <div class="stat-grid">
        <StatCard Label="Leads nuevos hoy" Value="@_hoy" Icon="inbox" AccentColor="var(--brand)" Delta="+2" Sub="vs. ayer" />
        <StatCard Label="Esta semana"       Value="@_semana" Icon="bar-chart" AccentColor="var(--frio)" Sub="últimos 7 días" />
        <StatCard Label="Este mes"          Value="@_mes"    Icon="trending-up" AccentColor="var(--tibio)" Sub="últimos 30 días" />
        <StatCard Label="Leads calientes"   Value="@_caliente" Icon="flame" AccentColor="var(--caliente)" Sub="@($"{_calientePct}% del total")" />
    </div>

    <div class="panels-2">
        <!-- Bar chart -->
        <div class="big-panel">
            <div class="bp-head">
                <h3>Leads nuevos · últimos 14 días</h3>
                <span class="bp-total">@_days.Sum(d => d.Count) en total</span>
            </div>
            <div class="bars">
                @{ int maxVal = Math.Max(_days.Max(d => d.Count), 1); }
                @foreach (var day in _days)
                {
                    <div class="bar-col">
                        <div class="bar-wrap">
                            @if (day.Count > 0)
                            {
                                <div class="bar-val">@day.Count</div>
                            }
                            <div class="bar" style="height:@(day.Count * 100 / maxVal)%; opacity:@(day.DaysAgo == 0 ? "1" : "0.78")"></div>
                        </div>
                        <div class="bar-lbl @(day.DaysAgo == 0 ? "today" : "")">@(day.DaysAgo == 0 ? "Hoy" : day.Label)</div>
                    </div>
                }
            </div>
        </div>

        <!-- Distribution -->
        <div class="big-panel">
            <div class="bp-head">
                <h3>Por temperatura</h3>
                <span class="bp-total">@_all.Count leads</span>
            </div>
            <div class="dist">
                @foreach (var (temp, color, label) in new[] {
                    (Temperatura.Caliente, "var(--caliente)", "Caliente"),
                    (Temperatura.Tibio,    "var(--tibio)",    "Tibio"),
                    (Temperatura.Frio,     "var(--frio)",     "Frío") })
                {
                    var count = _all.Count(l => l.Temp == temp);
                    var pct = _all.Count > 0 ? count * 100 / _all.Count : 0;
                    <div class="dist-row">
                        <div class="dist-lbl" style="color:@color">@label</div>
                        <div class="dist-track">
                            <div class="dist-fill" style="width:@pct%;background:@color"></div>
                        </div>
                        <div class="dist-num">@count · @pct%</div>
                    </div>
                }
            </div>
            <div class="conv-box">
                <div class="conv-pct">@_calientePct%</div>
                <div class="conv-txt">
                    tasa de leads calientes<br />
                    <span>derivados a un asesor 🔥</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Lead> _all = [];
    private int _hoy, _semana, _mes, _caliente, _calientePct;
    private List<DayBar> _days = [];

    protected override void OnInitialized()
    {
        _all     = DataService.GetLeads();
        _hoy     = _all.Count(l => l.DaysAgo == 0);
        _semana  = _all.Count(l => l.DaysAgo < 7);
        _mes     = _all.Count(l => l.DaysAgo < 30);
        _caliente = _all.Count(l => l.Temp == Temperatura.Caliente);
        _calientePct = _all.Count > 0 ? _caliente * 100 / _all.Count : 0;

        var wd = new[] { "D", "L", "M", "M", "J", "V", "S" };
        _days = Enumerable.Range(0, 14).Select(i =>
        {
            var daysAgo = 13 - i;
            var dt = DateTime.Now.AddDays(-daysAgo);
            return new DayBar(daysAgo, wd[(int)dt.DayOfWeek], _all.Count(l => l.DaysAgo == daysAgo));
        }).ToList();
    }

    private record DayBar(int DaysAgo, string Label, int Count);
}
