@page "/estadisticas"
@inject ApiService DataService
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Flujo.ai — Estadísticas</PageTitle>

@if (_loading)
{
    <div class="loading-wrap"><div class="spinner-border text-primary"></div></div>
}
else
{
    <header class="topbar">
        <div>
            <h1>Estadísticas</h1>
            <p class="subtitle">Resultados de Vera</p>
        </div>
        <div class="btn-group" role="group">
            <button class="btn btn-sm @(_allTime ? "btn-outline-secondary" : "btn-primary")" @onclick="() => SetRangeAsync(false)">Últimos 30 días</button>
            <button class="btn btn-sm @(_allTime ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SetRangeAsync(true)">Histórico</button>
        </div>
    </header>

    <div class="stats-view">
        @{ var s = _stats ?? new DashboardStats(); }

        <div class="card hover-lift mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <h3 class="font-serif fw-semibold fs-5 mb-0">Embudo de resultados</h3>
                    <span class="text-muted small text-uppercase fw-semibold">@s.Total leads captados</span>
                </div>
                @{ int funnelMax = Math.Max(s.Total, 1); }
                @foreach (var (label, count, color) in new[] {
                    ("Leads calificados", s.Calificados, "var(--tibio)"),
                    ("Listos para el asesor", s.Prontos, "var(--caliente)") })
                {
                    var pct = s.Total > 0 ? count * 100 / s.Total : 0;
                    var width = Math.Max(count * 100 / funnelMax, count > 0 ? 6 : 0);
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="fw-semibold" style="width:170px">@label</div>
                        <div class="progress flex-grow-1" style="height:34px;border-radius:var(--r-sm)">
                            <div class="progress-bar"
                                 style="width:@(width)%;background-color:@color;border-radius:var(--r-sm)"></div>
                        </div>
                        <div class="font-mono text-secondary small text-nowrap text-end" style="width:64px">@count · @pct%</div>
                    </div>
                }
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="card hover-lift h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-baseline mb-4">
                            <h3 class="font-serif fw-semibold fs-5 mb-0">Por temperatura</h3>
                            <span class="text-muted small text-uppercase fw-semibold">@s.Total leads</span>
                        </div>
                        @foreach (var (count, color, label) in new[] {
                            (s.Caliente, "var(--caliente)", "Caliente"),
                            (s.Tibio,    "var(--tibio)",    "Tibio"),
                            (s.Frio,     "var(--frio)",     "Frío") })
                        {
                            var pct = s.Total > 0 ? count * 100 / s.Total : 0;
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="fw-semibold" style="width:84px;color:@color">@label</div>
                                <div class="progress flex-grow-1" style="height:11px">
                                    <div class="progress-bar" style="width:@pct%;background-color:@color"></div>
                                </div>
                                <div class="font-mono text-secondary small text-nowrap">@count · @pct%</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card hover-lift h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-baseline mb-4">
                            <h3 class="font-serif fw-semibold fs-5 mb-0">Demanda por zona</h3>
                            <span class="text-muted small text-uppercase fw-semibold">top @s.PorZona.Count</span>
                        </div>
                        @if (s.PorZona.Count == 0)
                        {
                            <p class="text-muted small mb-0">Sin datos de zona todavía.</p>
                        }
                        else
                        {
                            int zonaMax = Math.Max(s.PorZona.Max(z => z.N), 1);
                            @foreach (var z in s.PorZona)
                            {
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="fw-semibold text-truncate" style="width:96px" title="@z.Zona">@z.Zona</div>
                                    <div class="progress flex-grow-1" style="height:11px">
                                        <div class="progress-bar" style="width:@(z.N * 100 / zonaMax)%;background-color:var(--brand)"></div>
                                    </div>
                                    <div class="font-mono text-secondary small">@z.N</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card hover-lift h-100">
                    <div class="card-body">
                        <h3 class="font-serif fw-semibold fs-5 mb-3">Leads fuera de horario</h3>
                        <div class="d-flex align-items-center gap-3 p-3"
                             style="background:var(--frio-soft);border:1px solid rgba(37,99,235,0.22);border-radius:var(--r-md)">
                            <div class="font-serif fw-semibold text-center" style="font-size:42px;line-height:1;color:var(--frio);min-width:52px">@s.FueraHorario</div>
                            <div>
                                <div class="fw-semibold">Leads rescatados</div>
                                <div class="text-muted small">Vera los atendió cuando no había nadie del equipo disponible</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card hover-lift h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-baseline mb-4">
                            <h3 class="font-serif fw-semibold fs-5 mb-0">Operación</h3>
                            <span class="text-muted small text-uppercase fw-semibold">@s.PorOperacion.Sum(o => o.N) leads</span>
                        </div>
                        @if (s.PorOperacion.Count == 0)
                        {
                            <p class="text-muted small mb-0">Sin datos de operación todavía.</p>
                        }
                        else
                        {
                            int opTotal = Math.Max(s.PorOperacion.Sum(o => o.N), 1);
                            @foreach (var o in s.PorOperacion)
                            {
                                var pct = o.N * 100 / opTotal;
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="fw-semibold text-truncate" style="width:96px" title="@o.Operacion">@o.Operacion</div>
                                    <div class="progress flex-grow-1" style="height:11px">
                                        <div class="progress-bar" style="width:@pct%;background-color:var(--green)"></div>
                                    </div>
                                    <div class="font-mono text-secondary small text-nowrap">@o.N · @pct%</div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardStats? _stats;
    private bool _allTime;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadAsync();
        _loading = false;
    }

    private async Task SetRangeAsync(bool allTime)
    {
        if (_allTime == allTime) return;
        _allTime = allTime;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var from = _allTime ? (DateTimeOffset?)null : DateTimeOffset.UtcNow.AddDays(-30);
        _stats = await DataService.GetDashboardStatsAsync(from);
    }
}
