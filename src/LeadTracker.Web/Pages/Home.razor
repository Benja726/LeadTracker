@page "/"
@inject ApiService DataService
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Flujo.ai — Leads</PageTitle>

@if (_loading)
{
    <div class="loading-wrap"><div class="spinner-border text-primary"></div></div>
}
else
{
    <header class="topbar">
        <div>
            <h1>Bandeja de Leads</h1>
            <p class="subtitle">@_leadsHoy nuevos hoy · @_all.Count en total</p>
        </div>
        <div class="date-chip">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Hoy, @DateTime.Now.ToString("d 'de' MMMM", new System.Globalization.CultureInfo("es-UY"))
        </div>
    </header>

    <div class="leads-view">
        <div class="d-flex flex-wrap align-items-center gap-3 px-4 py-3">
            <div class="input-group flex-grow-1" style="min-width:220px;max-width:420px">
                <span class="input-group-text bg-body border-end-0 text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </span>
                <input class="form-control border-start-0 ps-1" placeholder="Buscar por nombre o consulta…" @bind="_query" @bind:event="oninput" />
            </div>

            <div class="btn-group" role="group">
                @foreach (var (label, value) in new[] { ("Todos","todos"), ("Nuevos hoy","hoy"), ("Históricos","historicos") })
                {
                    <button class="btn btn-sm @(_filterTime == value ? "btn-primary" : "btn-outline-secondary")" @onclick="() => _filterTime = value">@label</button>
                }
            </div>

            <div class="btn-group" role="group">
                @foreach (var (label, value, color) in new[] {
                    ("Todos",     "todos",     ""),
                    ("Caliente",  "caliente",  "#B91C1C"),
                    ("Tibio",     "tibio",     "#B45309"),
                    ("Frío",      "frio",      "#2563EB") })
                {
                    <button class="btn btn-sm @(_filterTemp == value ? "btn-primary" : "btn-outline-secondary")" @onclick="() => _filterTemp = value">
                        @if (value != "todos")
                        {
                            <span class="d-inline-block rounded-circle me-1" style="width:7px;height:7px;background:@color"></span>
                        }
                        @label
                    </button>
                }
            </div>
        </div>

        <div class="lead-list">
            @{
                var filtered = GetFiltered();
                var hoy   = filtered.Where(l => l.DaysAgo == 0).ToList();
                var antes = filtered.Where(l => l.DaysAgo > 0).ToList();
            }

            @if (!filtered.Any())
            {
                <div class="empty">No hay leads que coincidan con el filtro.</div>
            }
            else if (_filterTime != "todos")
            {
                @foreach (var lead in filtered)
                {
                    <LeadRow Lead="lead" OnClick="OpenChat" />
                }
            }
            else
            {
                @if (hoy.Any())
                {
                    <div class="group-head">Nuevos hoy <span>@hoy.Count</span></div>
                    @foreach (var lead in hoy)
                    {
                        <LeadRow Lead="lead" OnClick="OpenChat" />
                    }
                }
                @if (antes.Any())
                {
                    <div class="group-head">Anteriores <span>@antes.Count</span></div>
                    @foreach (var lead in antes)
                    {
                        <LeadRow Lead="lead" OnClick="OpenChat" />
                    }
                }
            }
        </div>
    </div>

    @if (_selected is not null)
    {
        <ChatPanel Lead="_selected" OnClose="CloseChat" />
    }
}

@code {
    private List<Lead> _all = [];
    private Lead? _selected;
    private string _query = "";
    private string _filterTime = "todos";
    private string _filterTemp = "todos";
    private int _leadsHoy;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!await Auth.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }

        _all = await DataService.GetLeadsAsync();
        _leadsHoy = _all.Count(l => l.DaysAgo == 0);
        _loading = false;
    }

    private List<Lead> GetFiltered()
    {
        return _all.Where(l =>
        {
            if (_filterTemp != "todos" && l.Temp.ToString().ToLower() != _filterTemp) return false;
            if (_filterTime == "hoy" && l.DaysAgo != 0) return false;
            if (_filterTime == "historicos" && l.DaysAgo == 0) return false;
            if (!string.IsNullOrEmpty(_query))
            {
                var q = _query.ToLower();
                if (!l.Name.ToLower().Contains(q) && !l.Intent.ToLower().Contains(q)) return false;
            }
            return true;
        }).ToList();
    }

    private void OpenChat(Lead lead) => _selected = lead;
    private void CloseChat() => _selected = null;
}
