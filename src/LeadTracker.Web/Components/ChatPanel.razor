@using LeadTracker.Web.Models
@inject LeadTracker.Web.Services.ApiService Api

<div class="overlay" @onclick="() => OnClose.InvokeAsync()"></div>
<aside class="chat-panel" @onclick:stopPropagation>
    <header class="chat-head">
        <div class="avatar lg avatar-@Lead.Temp.ToString().ToLower()">@Initials(Lead.Name)</div>
        <div class="chat-head-info">
            <div class="chat-name">@Lead.Name</div>
            <div class="chat-sub">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                @Lead.Phone
            </div>
        </div>
        <span class="tbadge tbadge-@Lead.Temp.ToString().ToLower()">@TempLabel(Lead.Temp)</span>
        <button class="icon-btn" @onclick="() => OnClose.InvokeAsync()">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </header>

    <div class="chat-intent">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/></svg>
        <span>@Lead.Intent</span>
        <span class="ro-tag">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Solo lectura
        </span>
    </div>

    <div class="chat-body" @ref="_bodyRef">
        <div class="day-sep"><span>Historial del asistente</span></div>
        @foreach (var msg in Lead.Messages)
        {
            <div class="bubble-row @(msg.From == "bot" ? "bot-msg" : "lead-msg")">
                <div class="bubble @(msg.From == "bot" ? "bot-bubble" : "lead-bubble")">
                    @if (msg.From == "bot")
                    {
                        <div class="bot-tag">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
                            Vera · IA
                        </div>
                    }
                    <div class="bubble-text">@msg.Text</div>
                    <div class="bubble-time">@msg.Time</div>
                </div>
            </div>
        }
    </div>

    <footer class="chat-foot bot-foot">
        <label class="switch @(_busy ? "is-busy" : "")">
            <input type="checkbox" checked="@Lead.BotEnabled" @onchange="ToggleBot" disabled="@_busy" />
            <span class="slider"></span>
        </label>
        <div class="bot-foot-text">
            <span class="bot-foot-title @(Lead.BotEnabled ? "on" : "off")">
                @(Lead.BotEnabled ? "Bot activo" : "Atendido por humano")
            </span>
            @if (Lead.BotEnabled)
            {
                <span class="bot-foot-sub">El asistente responde automáticamente vía WhatsApp.</span>
            }
            else
            {
                <span class="bot-foot-sub off">@BotStatusLine()</span>
            }
        </div>
    </footer>
</aside>

@code {
    [Parameter, EditorRequired] public Lead Lead { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }

    private ElementReference _bodyRef;
    private bool _busy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Task.Yield();
    }

    private async Task ToggleBot(ChangeEventArgs e)
    {
        var newVal = e.Value is bool b && b;
        var prev = (Lead.BotEnabled, Lead.BotDisabledReason, Lead.BotDisabledAt);

        // Optimistic update.
        Lead.BotEnabled = newVal;
        Lead.BotDisabledReason = newVal ? null : "manual";
        Lead.BotDisabledAt = newVal ? null : DateTime.UtcNow;
        _busy = true;

        var res = await Api.SetBotEnabledAsync(Lead.Phone, newVal);

        _busy = false;
        if (res is null)
        {
            // Revert on failure.
            (Lead.BotEnabled, Lead.BotDisabledReason, Lead.BotDisabledAt) = prev;
        }
        else
        {
            // Revalidate with authoritative server state.
            Lead.BotEnabled = res.BotEnabled;
            Lead.BotDisabledReason = res.BotDisabledReason;
            Lead.BotDisabledAt = res.BotDisabledAt;
        }
    }

    private string BotStatusLine()
    {
        var reason = Lead.BotDisabledReason switch
        {
            "manual"      => "manual",
            "coexistence" => "app de WhatsApp",
            null or ""    => "apagado",
            var r         => r
        };
        var when = Lead.BotDisabledAt is { } at ? $" · {RelativeEs(at)}" : "";
        return $"Bot apagado · {reason}{when}";
    }

    private static string RelativeEs(DateTime utc)
    {
        var span = DateTime.UtcNow - utc.ToUniversalTime();
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        if (span.TotalMinutes < 1)  return "hace instantes";
        if (span.TotalMinutes < 60) return $"hace {(int)span.TotalMinutes} min";
        if (span.TotalHours < 24)   return $"hace {(int)span.TotalHours} h";
        return $"hace {(int)span.TotalDays} d";
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ').Take(2).Select(w => w[0])).ToUpper();

    private static string TempLabel(Temperatura t) => t switch
    {
        Temperatura.Caliente => "Caliente",
        Temperatura.Tibio    => "Tibio",
        _                    => "Frío"
    };
}
